# Password to access the webchat
CHAT_PASSWORD=changeme

# OpenClaw Gateway base URL (no trailing slash)
OPENCLAW_GATEWAY_URL=http://localhost:18789

# Bearer token for OpenClaw Gateway authentication
OPENCLAW_GATEWAY_TOKEN=

# Agent ID to target (default: main)
OPENCLAW_AGENT_ID=main

# User identifier for session persistence (all requests with the same user share conversation history)
CHAT_USER=zhangting

# Instructions merged into the system prompt (optional)
CHAT_INSTRUCTIONS=Zhangting is Jerome's girlfriend from China. Be extra supportive.

# Secret for signing session cookies (use a long random string)
SESSION_SECRET=please-change-me-to-a-random-string

# Server port
PORT=3000
